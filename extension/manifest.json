{
  "manifest_version": 3,
  "name": "VoxNovel Importer",
  "version": "1.0.0",
  "description": "1-Click novel chapter importer for ReadToon and web novels into VoxNovel for AI reading and VoxCPM2 TTS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://readtoon.com/*",
    "https://*.readtoon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoxNovel Importer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://readtoon.com/content/*",
        "https://*.readtoon.com/content/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
