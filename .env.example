# OpenRouter API Key (required for openrouter translation)
OPENROUTER_API_KEY=

# Optional Gemini API Key
GEMINI_API_KEY=

# Draft translation model. Defaults to google/gemma-4-31b-it:free, which works
# without credits but cannot sustain a whole novel -- free tiers are capped at
# 50 requests/day and the shared pool rejects translation-sized batches.
# See docs/model-selection.md for measured costs.
OPENROUTER_MODEL=

# Optional: point at any OpenAI-compatible server instead of OpenRouter --
# Ollama (http://localhost:11434/v1), vLLM, llama.cpp. A local GPU then serves
# translation and speaker attribution with no per-chapter cost or rate limit.
OPENROUTER_BASE_URL=

# Optional: comma-separated models to try if the primary one fails.
OPENROUTER_FALLBACK_MODELS=

# Optional: run the editor/polish pass on a stronger model than the draft.
# Leave empty to reuse the draft model. Putting the stronger model here rather
# than on the draft is both cheaper and more effective -- see the cost table in
# docs/model-selection.md.
OPENROUTER_POLISH_MODEL=

# Optional: remote VoxCPM2 TTS server (OpenAI-compatible /v1/audio/speech).
# Leave empty to run locally, which needs the optional "tts" extra installed.
VOXCPM_API_URL=
VOXCPM_API_KEY=

# auto | mps | cuda | cpu
VOXCPM_DEVICE=auto

# Optional: ReadToon session token, for scraping unlocked paid chapters.
# The Chrome extension is the supported path for locked chapters.
READTOON_AUTH_TOKEN=

# Optional: restrict which origins may call the local API. Defaults to the
# extension, localhost, and readtoon.com. Never widen this to "*".
VOXNOVEL_ALLOWED_ORIGIN_REGEX=
